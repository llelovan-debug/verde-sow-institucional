{
  "name": "verde-sow-institucional",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint \"assets/js/**/*.js\" vite.config.js eslint.config.js",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:staged": "lint-staged",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.css": "stylelint --fix",
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^7.1.0"
  }
}
